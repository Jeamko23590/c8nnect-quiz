{
  "version": 2,
  "name": "c8nnect-quiz-backend",
  "builds": [
    {
      "src": "pom.xml",
      "use": "@vercel/java",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "SPRING_PROFILES_ACTIVE": "prod"
  }
}
