# Development Environment Variables
NODE_ENV=development
PORT=8080

# Database Connection (Choose one method)

# Method 1: Full Connection String (Recommended for Neon)
DATABASE_URL=jdbc:postgresql://localhost:5432/quizdb?user=postgres&password=postgres

# Method 2: Individual Parameters (For local PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=quizdb
# DB_USER=postgres
# DB_PASSWORD=postgres

# CORS
FRONTEND_URL=http://localhost:3000
